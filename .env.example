# Knowledge Dungeon has no required environment variables.
# The desktop (Electron) build is fully offline and local-first.
# This file exists as a placeholder for future opt-in flags.
#
# Everything below is a build-time flag. Vite inlines VITE_* at build time, so a
# value here is compiled into the artifact and is never a runtime setting, a URL
# parameter, or something a learner can change. Flags must never contain learner
# data. Unset means the safe production default; a malformed value fails the build.

# Base path the app is served from. Defaults to "/" for web and "./" for Electron.
# VITE_BASE_PATH=/

# Phase 11 village renderer switch. When true, the village route loads the lazy
# PixiJS Village world instead of the Phaser village. `build:web:pixi-village` sets
# this without changing VITE_WORLD_RENDERER, so the village is the only thing
# switched on. Build-time only.
# Default: false (Phaser village).
# Rollback: set false, or remove the override, to retain the Phaser village path.
# VITE_PIXI_VILLAGE=false

# Phase 13 dungeon renderer switch. When true, the dungeon route loads the lazy
# PixiJS Dungeon world instead of the Phaser dungeon. `build:web:pixi-dungeon` sets
# this without changing VITE_WORLD_RENDERER or VITE_PIXI_VILLAGE, so the dungeon is
# the only thing switched on. Build-time only.
# Default: false (Phaser dungeon).
# Rollback: set false, or remove the override, to retain the Phaser dungeon path.
# VITE_PIXI_DUNGEON=false

# Phase 14 Creator workspace switch. When true, the Creator room opens the
# redesigned Creator workspace, where subject mapping is the first-class dungeon
# workspace, instead of the existing RoomPanel Creator view. Build-time only.
# Default: false (existing RoomPanel Creator view).
# Rollback: set false, or remove the override, to retain the existing RoomPanel Creator view.
# VITE_CREATOR_WORKSPACE=false

# Phase 15 Scribe encounter workspace switch. When true, the Scribe encounter opens
# the redesigned Scribe encounter workspace, where editing, preview, attachments, and
# checklists live in React DOM, instead of the existing NoteEditorModal. Build-time
# only. Note validation, progression, and artifact generation are unchanged by this
# flag: it selects which view a learner sees, not what counts as a valid note.
# Default: false (existing NoteEditorModal).
# Rollback: set false, or remove the override, to retain the existing NoteEditorModal as the Scribe view.
# VITE_SCRIBE_ENCOUNTER_WORKSPACE=false

# Phase 16 Archaeologist review workspace switch. When true, the Archaeologist room opens
# the redesigned review workspace, where the current artifact, recall prompt, rating, next
# due date, and pass progress live in React DOM, instead of the existing room-panel review
# view. Build-time only. Review scheduling, SM-2 values, and progression are unchanged by
# this flag: it selects which view a learner sees, not what counts as a review pass.
# Default: false (existing room-panel review view).
# Rollback: set false, or remove the override, to retain the existing RoomPanel review view.
# VITE_ARCHAEOLOGIST_REVIEW_WORKSPACE=false

# Phase 22 offline static-shell switch. When true, the build emits the hand-written
# service worker, a versioned shell precache manifest generated from the emitted
# index.html, and a registration script, so a previously loaded app can reload with
# no network. It caches build-time shell assets only and never reads or writes
# IndexedDB, so learner data is never cached. Build-time only.
# Default: false (no service worker, no shell manifest, no registration script - the
# default artifact is unchanged).
# Rollback: set false, or remove the override, to remove the service worker path.
# VITE_OFFLINE_SHELL=false
