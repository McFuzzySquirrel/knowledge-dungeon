# Knowledge Dungeon has no required environment variables.
# The desktop (Electron) build is fully offline and local-first.
# This file documents the optional build-time flags.
#
# Everything below is a build-time flag. Vite inlines VITE_* at build time, so a
# value here is compiled into the artifact and is never a runtime setting, a URL
# parameter, or something a learner can change. Flags must never contain learner
# data. Unset means the production default shown; a malformed value fails the build.
#
# PHASE 23 CUTOVER: the rebuilt stack is now the production default. Every flag
# below is retained for one release as a documented rollback to its pre-cutover
# behaviour - set the rollback value to restore the previous behaviour. The only
# kill switch (a flag with no pre-cutover behaviour) is VITE_AUDIO_ENABLED.

# Base path the app is served from. Defaults to "/" for web and "./" for Electron.
# VITE_BASE_PATH=/

# World host adapter. This is NOT a world-renderer switch: the PixiJS dungeon, village,
# and fishing worlds are selected by VITE_PIXI_DUNGEON, VITE_PIXI_VILLAGE, and
# VITE_PIXI_FISHING. `phaser` is the application host and stays the default; `pixi`
# selects the Phase 9 test host (not a production world) and is removed in Phase 24.
# Default: phaser. Explicit test host: VITE_WORLD_RENDERER=pixi.
# VITE_WORLD_RENDERER=phaser

# Storage generation (legacy mirror writes are retained in both modes).
# Default: v2. Rollback: VITE_STORAGE_REPOSITORY=legacy.
# VITE_STORAGE_REPOSITORY=v2

# Phase 11 village renderer.
# Default: true (lazy PixiJS Village world). Rollback: VITE_PIXI_VILLAGE=false
# (Phaser village path).
# VITE_PIXI_VILLAGE=true

# Phase 13 dungeon renderer.
# Default: true (lazy PixiJS Dungeon world). Rollback: VITE_PIXI_DUNGEON=false
# (Phaser dungeon path).
# VITE_PIXI_DUNGEON=true

# Phase 17 fishing renderer.
# Default: true (lazy PixiJS Fishing world). Rollback: VITE_PIXI_FISHING=false
# (Phaser fishing path).
# VITE_PIXI_FISHING=true

# Phase 8 Cozy visual system.
# Default: true. Rollback: VITE_COZY_VISUALS=false (legacy renderer themes).
# VITE_COZY_VISUALS=true

# Phase 19 Gentle (adaptive) assistance.
# Default: true. Rollback: VITE_ADAPTIVE_ASSISTANCE=false (locally stored
# assistance records are left untouched).
# VITE_ADAPTIVE_ASSISTANCE=true

# Phases 5-7 versioned data products (.kdbak / .kdsubject / templates).
# Default: true. Rollback: VITE_DATA_PRODUCTS_V2=false (legacy local and
# export/import paths remain available).
# VITE_DATA_PRODUCTS_V2=true

# Phase 20 explicit-action Web Share.
# Default: true. Rollback: VITE_WEB_SHARE=false (local PNG download only).
# VITE_WEB_SHARE=true

# Phase 10 audio service. Default: true. This is a kill switch, not a rollback:
# there is no pre-Phase-10 audio behaviour to restore. Set false to disable audio
# and retain the procedural art fallbacks.
# VITE_AUDIO_ENABLED=true

# Phase 14 redesigned Creator workspace.
# Default: true. Rollback: VITE_CREATOR_WORKSPACE=false (existing RoomPanel
# Creator view).
# VITE_CREATOR_WORKSPACE=true

# Phase 15 redesigned Scribe encounter workspace. Note validation, progression,
# and artifact generation are unchanged by this flag.
# Default: true. Rollback: VITE_SCRIBE_ENCOUNTER_WORKSPACE=false (existing
# NoteEditorModal).
# VITE_SCRIBE_ENCOUNTER_WORKSPACE=true

# Phase 16 redesigned Archaeologist review workspace. Review scheduling, SM-2
# values, and progression are unchanged by this flag.
# Default: true. Rollback: VITE_ARCHAEOLOGIST_REVIEW_WORKSPACE=false (existing
# RoomPanel review view).
# VITE_ARCHAEOLOGIST_REVIEW_WORKSPACE=true

# Phase 22 offline static-shell service worker. It caches build-time shell assets
# only and never caches learner data.
# Default: true. Rollback: VITE_OFFLINE_SHELL=false (no sw.js, no shell manifest,
# no registration script).
# VITE_OFFLINE_SHELL=true
